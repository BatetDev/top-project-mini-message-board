<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mini Message Board</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <h1>Mini Message Board</h1>
    <% messages.forEach((message, index) => { %> 
      <div class="message">
<p class="message-meta">
  <strong><%= message.user %></strong> wrote on <%= message.added.toLocaleString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
</p>
<p class="message-text"><%= message.text %></p>
<div class="message-actions">
  <a href="/message/<%= index %>" class="button">View message</a>
</div>
      </div>
      <% }) %>
      <a href="/new" class="button">New Message</a>
  </body>
</html>
